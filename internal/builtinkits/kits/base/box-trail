#!/usr/bin/env bash
# box-trail — render Claude Code hook events from the JSONL trail file as one
# color-coded line per event. Used in the auditor layout's trail pane.
#
# Reads $BOX_TRAIL_FILE; if the var is empty (trail not wired for this agent),
# prints a placeholder message and sleeps forever so the pane stays visible.
#
# Schema drift notes (verified against Claude Code 2.1.128 live payloads):
#   - PostToolUse includes `tool_response` (not `tool_result`). The detail
#     field is extracted from `tool_input` subfields, so this mostly doesn't
#     affect rendering — but the schema is documented in docs/TRAIL.md.
#   - Stop events have `last_assistant_message` (not `reason`). The jq chain
#     falls back to `.last_assistant_message` for Stop/StopFailure events.

set -u

trail="${BOX_TRAIL_FILE:-}"

if [ -z "$trail" ]; then
    printf '\033[1;33m── trail not configured for this agent ──\033[0m\n'
    printf 'Trail is currently Claude-only. The auditor layout works\n'
    printf 'best with `--agent claude`.\n'
    while :; do sleep 3600; done
fi

hdr() { printf '\033[1;2m── %s ──\033[0m\n' "$1"; }
hdr "trail: $trail"

# Color codes per event kind.
color_for_event() {
    case "$1" in
        PreToolUse)         printf '\033[2m'    ;;  # dim (high volume; quiet them)
        PostToolUse)        printf '\033[36m'   ;;  # cyan
        PostToolUseFailure) printf '\033[31m'   ;;  # red
        Stop)               printf '\033[35m'   ;;  # magenta
        StopFailure)        printf '\033[1;31m' ;;  # bold red
        *)                  printf '\033[37m'   ;;  # white (unknown)
    esac
}

# tail -F: tolerant of missing files (waits for creation), truncation, rotation.
tail -n +1 -F "$trail" 2>/dev/null | while IFS= read -r line; do
    # Skip blank lines and lines that aren't valid JSON objects.
    [ -z "$line" ] && continue
    event=$(printf '%s' "$line" | jq -r '.hook_event_name // empty' 2>/dev/null)
    [ -z "$event" ] && continue

    tool=$(printf '%s' "$line" | jq -r '.tool_name // empty' 2>/dev/null)

    # Extract the most relevant detail field, adapting for schema drifts:
    #   - Standard tool events: prefer command > file_path > url from tool_input.
    #   - Stop/StopFailure: use last_assistant_message (not `reason` — absent in
    #     Claude Code 2.1.128; see docs/TRAIL.md "Schema drift" section).
    detail=$(printf '%s' "$line" | jq -r '
        .tool_input.command
        // .tool_input.file_path
        // .tool_input.url
        // .last_assistant_message
        // ""
    ' 2>/dev/null)

    dur=$(printf '%s' "$line" | jq -r '.duration_ms // empty' 2>/dev/null)

    # Prefer trail_ts (added by agentbox-hook-record) over raw hook fields.
    ts=$(printf '%s' "$line" | jq -r '.trail_ts // ""' 2>/dev/null | cut -c12-19)
    [ -z "$ts" ] && ts="--:--:--"

    # Truncate detail to 60 cols to keep lines readable in the trail pane.
    if [ "${#detail}" -gt 60 ]; then
        detail="${detail:0:57}..."
    fi

    color=$(color_for_event "$event")
    suffix=""
    if [ -n "$dur" ] && [ "$dur" != "null" ]; then
        suffix=$(printf '\033[2m %sms\033[0m' "$dur")
    fi

    printf '%s%s  %-22s  %-8s  %s%s\033[0m\n' \
        "$color" "$ts" "$event" "$tool" "$detail" "$suffix"
done
